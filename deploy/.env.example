# Runtime environment for the container on the VPS.
# Copy to `.env` next to docker-compose.yml and fill in. Never commit the copy.
#
# Everything here is read at request time by the running server, so changing a
# value means `docker compose up -d` — not a rebuild. This mirrors web/.env.example
# (the full reference, with why each one exists) — kept in sync by hand since one
# is the annotated source and the other is what actually ships to the server.

# ── Invite gate ──────────────────────────────────────────────────────────────
# One shared code per market: "<code>:<market_id>", comma separated.
# Omit to fall back to the built-in defaults (sgv-founding, pasadena).
SEED_INVITE_CODES=sgv-founding:pasadena,pasadena:pasadena

# ── n8n backend ──────────────────────────────────────────────────────────────
# Hooks resolve to <N8N_BASE_URL>/webhook/pando-<hook> unless overridden below.
# While these are empty the app runs fully and API responses report
# `persisted: false` instead of pretending the data was stored.
N8N_BASE_URL=
N8N_WEBHOOK_INVITE=
N8N_WEBHOOK_PROFILE=
N8N_WEBHOOK_CHAT=
N8N_WEBHOOK_SAVE=
N8N_WEBHOOK_COMPLETE=
# Sent as the X-Pando-Token header; check it in the n8n workflow.
N8N_WEBHOOK_TOKEN=

# ── Admin ────────────────────────────────────────────────────────────────────
# The admin does not exist until BOTH of these are set — an unprotected admin is a
# worse failure than an unavailable one. Without them, /admin is simply dark.
ADMIN_PASSWORD=
ADMIN_USERS=janet,andrii
# Optional: signs the session cookie. Derived from ADMIN_PASSWORD when empty.
ADMIN_SESSION_SECRET=
N8N_WEBHOOK_ADMIN_READ=
N8N_WEBHOOK_ADMIN_WRITE=

# ── Phone verification ───────────────────────────────────────────────────────
# Set to 0 while Twilio isn't provisioned yet — the founding path then posts
# straight through instead of holding for a code nobody can receive.
SEED_REQUIRE_VERIFICATION=0
SEED_VERIFY_SECRET=
# Never set this to 1 in production — it prints the OTP on screen.
SEED_VERIFY_DEV_CODES=0

# ── Twilio (leave empty until the A2P campaign is approved) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── Analytics (provider not wired yet — safe to leave empty) ─────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
