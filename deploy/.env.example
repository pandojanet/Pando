# Runtime environment for the container on the VPS.
# Copy to `.env` next to docker-compose.yml and fill in. Never commit the copy.
#
# Everything here is read at request time by the running server, so changing a
# value means `docker compose up -d` — not a rebuild. This mirrors web/.env.example
# (the full reference, with why each one exists) — kept in sync by hand since one
# is the annotated source and the other is what actually ships to the server.

# ── Invite gate ──────────────────────────────────────────────────────────────
# The **fallback**. Invites now live in the `invites` table, one row per parent
# group, managed at /admin/invites — that is where a new group's link comes from,
# and it needs no deploy. This list is what answers when the database is
# unconfigured or unreachable, and it keeps the original codes alive.
#
# Format: "<code>:<market_id>", comma separated. Omit for the built-in defaults.
SEED_INVITE_CODES=sgv-founding:pasadena,pasadena:pasadena

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Use the **pooler** host (IPv4). The direct host is IPv6-only without the paid
# add-on, and this VPS is IPv4:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Empty is a supported state: the app runs and every write route reports
# `persisted: false` rather than pretending. /api/health stays ok in that case,
# and goes 503 only when a URL is set but unreachable — which is what a rollout
# should refuse to go live on.
DATABASE_URL=

# ── Extraction (estimate 1.8/1.9) ────────────────────────────────────────────
# Scores each contribution's free text 0-1 and raises a flag when it looks like
# it names a person. Unset ⇒ no extraction runs, `confidence` stays null, and
# the admin shows "no extraction run yet" — a wrong score is worse than none,
# because it would sort a card out of the very queue meant to catch it.
#
# Never reads a caregiver's restricted notes (invariant 12), and never logs the
# text it scores (invariant 7).
ANTHROPIC_API_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# The admin does not exist until one of the modes below is configured — without
# either, /admin is simply dark, which beats open without a password.
#
# Credentials live in the database (`admin_users`), managed with the same CLI and
# from the same place as migrations — a checkout, pointed at this deployment's
# database, never from inside the container (the runtime image is a standalone
# bundle with no scripts in it):
#
#     MIGRATE_DATABASE_URL="<the 5432 pooler URL>" npm run admin:user -- add janet
#     MIGRATE_DATABASE_URL="<…>" npm run admin:user -- disable someone
#
# A populated table is authoritative and this file is not consulted — which is the
# point: taking access away is a statement, not a redeploy.
#
# ⚠️ The pilot database currently has `janet` and `andrii` on the starter password
# `pando` — hashed, but five characters. Each of them changes it at /admin/account
# on first sign-in; that form requires 12. This must not still be true on the day
# the first real founding contributor is stored.
#
# BOOTSTRAP ONLY — one scrypt record per person, comma-separated, used while that
# table is empty. Generate each on any machine with the repo checked out; the hash
# is portable and the password never reaches this file:
#
#     npm run admin:credential -- janet
#
ADMIN_CREDENTIALS=
# Set this here. With it, rotating one person's password ends only their sessions.
ADMIN_SESSION_SECRET=
#
# DEPRECATED shared password, read only when ADMIN_CREDENTIALS is empty. In this
# mode the audit-log name is picked rather than proved. Delete both once the
# records above are in place.
ADMIN_PASSWORD=
ADMIN_USERS=janet,andrii

# ── Phone verification ───────────────────────────────────────────────────────
# Until Twilio is provisioned no code can be sent, and with neither switch below
# the server stores NOTHING: every founding parent holds their answers on their
# phone and never gets past the gate. Pick one.
#
#  1 = keep the whole OTP and print the code on screen instead of texting it.
#      6 digits, 5-minute expiry, 3 sends, 3 guesses, 15-minute lock — all real.
#      This is the one for pilot-scale testing on the server.
# Removes proof the parent holds the number, so rows written under it are not
# evidence of consent (/admin/consents is the A2P §3.3 defence file). Clear or
# mark them is_test, and unset this before the first real founding contributor.
SEED_VERIFY_DEV_CODES=1
# Or 0 here to skip the OTP entirely: everything stores, phone_verified_at stays
# null, nobody reaches Founding until they confirm later. Tests less. Leave at 1
# when using SEED_VERIFY_DEV_CODES above.
SEED_REQUIRE_VERIFICATION=1
SEED_VERIFY_SECRET=

# ── Twilio (leave empty until the A2P campaign is approved) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── Analytics ────────────────────────────────────────────────────────────────
# NOTE: NEXT_PUBLIC_POSTHOG_KEY / _HOST are deliberately NOT here. Unlike every
# other value in this file they are read at *build* time, not request time —
# Next inlines them into the client bundle — so setting them on the server has
# no effect at all, silently. They are repo secrets passed as Docker build args;
# see DEPLOY.md §3.
#
# This one is server-side and does belong here: the URL the admin overview links
# to for the PostHog dashboard. Optional; the link is hidden when unset.
POSTHOG_DASHBOARD_URL=
