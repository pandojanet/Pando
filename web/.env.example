# ── Invite gate (estimate 1.1) ───────────────────────────────────────────────
# One shared code per market: "<code>:<market_id>", comma separated.
# Omit to fall back to the built-in defaults (sgv-founding, pasadena).
SEED_INVITE_CODES=sgv-founding:pasadena,pasadena:pasadena

# ── n8n backend ──────────────────────────────────────────────────────────────
# Hooks resolve to <N8N_BASE_URL>/webhook/pando-<hook> unless overridden below.
# While these are empty the app runs fully, and API responses report
# `persisted: false` instead of pretending the data was stored.
#
# ⚠ Setting a hook makes it required: if the workflow is unreachable the route
# answers 502 and the parent sees a retry. Leave it empty unless n8n is running.
N8N_BASE_URL=
N8N_WEBHOOK_INVITE=
# Estimate 1.3 — the derivation scenario. Its webhook path is a custom route, so
# set the full URL rather than relying on N8N_BASE_URL:
#   N8N_WEBHOOK_PROFILE=https://n8n-dxmd.srv1576782.hstgr.cloud/webhook/profile-affinity-derivation
# While building it, use the test URL instead (/webhook-test/…) — that one accepts
# a single call per "Execute workflow" click.
# Instructions: n8n/1.3-profile-derive.md
N8N_WEBHOOK_PROFILE=
N8N_WEBHOOK_CHAT=
N8N_WEBHOOK_SAVE=
N8N_WEBHOOK_COMPLETE=
# Sent as the X-Pando-Token header when set, and simply omitted when it isn't — so
# leave it empty while the n8n webhooks have no authentication configured.
N8N_WEBHOOK_TOKEN=

# ── Admin (estimate 2.1) ─────────────────────────────────────────────────────
# The admin does not exist until BOTH of these are set — an unprotected admin is a
# worse failure than an unavailable one. One shared password, plus the list of
# people who may sign in, so every audit row carries a name.
ADMIN_PASSWORD=
ADMIN_USERS=janet,andrii
# Optional: signs the session cookie. Derived from ADMIN_PASSWORD when empty, which
# means changing the password invalidates existing sessions.
ADMIN_SESSION_SECRET=

# Admin reads and writes go through two n8n hooks (one Switch each). Unset ⇒ the
# pages show an empty state and offer clearly-labelled sample rows.
N8N_WEBHOOK_ADMIN_READ=
N8N_WEBHOOK_ADMIN_WRITE=

# ── Analytics (estimate 3.1 — call sites exist, provider not wired) ──────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Phone verification + SMS (client's v3.2 round) ───────────────────────────
# The founding path holds the profile and every card on the parent's phone until a
# six-digit code is confirmed; only then is anything sent. Set to 0 to switch the
# gate off for a local walkthrough or a pre-A2P demo (writes then behave as before).
SEED_REQUIRE_VERIFICATION=1
# Signs the pending-verification cookie. Falls back to ADMIN_SESSION_SECRET.
SEED_VERIFY_SECRET=
# QA only: returns the code in the API response and prints it on screen, so the
# whole flow can be walked while the A2P campaign is still with the carriers.
# Never set this in production.
SEED_VERIFY_DEV_CODES=
# Twilio. All three are required before a single text can go out, and sends always
# use the Messaging Service — never a bare number (client's instruction).
# Blocked on: A2P 10DLC campaign approval + the Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
