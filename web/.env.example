# ── Invite gate (estimate 1.1) ───────────────────────────────────────────────
# One shared code per market: "<code>:<market_id>", comma separated.
# Omit to fall back to the built-in defaults (sgv-founding, pasadena).
SEED_INVITE_CODES=sgv-founding:pasadena,pasadena:pasadena

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Use the **pooler** host, not the direct one: Supabase's direct host is
# IPv6-only without the paid add-on, and an IPv4 VPS cannot reach it. The pooler
# is IPv4 and looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Port 6543 is transaction mode; lib/server/db.ts disables prepared statements
# for it. Port 5432 on the same host is session mode and also works.
#
# Leave this empty and the app still runs end to end: every write route answers
# `persisted: false` and no screen claims a contribution was stored.
DATABASE_URL=

# ── Extraction (estimate 1.8/1.9) ────────────────────────────────────────────
# Scores each contribution's free text 0-1 and raises a flag when it looks like
# it names a person. Unset ⇒ no extraction runs, `confidence` stays null, and
# the admin shows "no extraction run yet" — a wrong score is worse than none,
# because it would sort a card out of the very queue meant to catch it.
#
# Never reads a caregiver's restricted notes (invariant 12), and never logs the
# text it scores (invariant 7).
ANTHROPIC_API_KEY=

# ── Admin (estimate 2.1) ─────────────────────────────────────────────────────
# The admin does not exist until one of the two modes below is configured — an
# unprotected admin is a worse failure than an unavailable one.
#
# One scrypt record per person. No password is stored, here or anywhere; what is
# stored cannot be replayed. Generate a record with:
#
#     npm run admin:credential -- janet
#
# It prints a passphrase to hand over once, and the record to paste here. Repeat
# per person and join the records with commas.
ADMIN_CREDENTIALS=
#
# Set this in production. With it, rotating one person's password ends only that
# person's sessions; without it the key is derived from the records above, so
# rotating anyone's password signs everyone out. Any long random string.
ADMIN_SESSION_SECRET=
#
# DEPRECATED — the original shared password, read only when ADMIN_CREDENTIALS is
# empty. In this mode the name on an audit row is *picked from a list*, not proved:
# anyone holding the password can sign in as anyone, which defeats the point of
# attributing a caregiver decision to a person. Kept so an existing deployment does
# not go dark on the deploy that adds ADMIN_CREDENTIALS. Delete both once you have
# moved; the sign-in screen warns while they are in use.
ADMIN_PASSWORD=
ADMIN_USERS=janet,andrii


# ── Analytics (estimate 3.1 / M3) ────────────────────────────────────────────
# Unset ⇒ `lib/posthog-provider.tsx` initialises nothing and every `track()` call
# is a no-op. Autocapture and session recording are off in the provider and must
# stay off (invariant 7 — see CLAUDE.md Decisions).
#
# ⚠️ These two are read at BUILD time, not request time: Next inlines any
# `NEXT_PUBLIC_*` into the client bundle during `next build`. Locally that means
# restarting `npm run dev` after changing them. In production it means they are
# Docker build args passed by CI from repo secrets — putting them in
# /docker/pando/.env does nothing. See DEPLOY.md §3.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side, request-time: the dashboard the admin overview links to.
# Optional — the link is hidden when unset.
POSTHOG_DASHBOARD_URL=

# ── Phone verification + SMS (client's v3.2 round) ───────────────────────────
# The founding path holds the profile and every card on the parent's phone until a
# six-digit code is confirmed; only then is anything sent. Set to 0 to switch the
# gate off for a local walkthrough or a pre-A2P demo (writes then behave as before).
SEED_REQUIRE_VERIFICATION=1
# Signs the pending-verification cookie. Falls back to ADMIN_SESSION_SECRET.
SEED_VERIFY_SECRET=
# QA only: returns the code in the API response and prints it on screen, so the
# whole flow can be walked while the A2P campaign is still with the carriers.
# Never set this in production.
SEED_VERIFY_DEV_CODES=
# Twilio. All three are required before a single text can go out, and sends always
# use the Messaging Service — never a bare number (client's instruction).
# Blocked on: A2P 10DLC campaign approval + the Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
