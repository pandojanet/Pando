        "jsCode": "// One pending option per item, with the contributor who typed it.\nconst personId = $('Save contributor').first().json.person_id;\nconst body = $('Webhook').first().json.body;\nreturn $input.all().map(item => ({\n  json: {\n    payload: {\n      market_id: body.market_id || 'pasadena',\n      category: item.json.category,\n      submitted_value: item.json.submitted_value,\n      person_id: personId,\n    },\n  },\n}));"
      },
