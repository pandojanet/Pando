{
  "name": "Pando · 1.9 annotation and flags (HTTP)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -700,
        300
      ],
      "id": "pando-every-15-minutes",
      "name": "Every 15 minutes",
      "notes": "Rules, not a model: cheap, predictable, and it over-flags on purpose.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/flag_rules",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Profile",
              "value": "public"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: {} }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -460,
        300
      ],
      "id": "pando-run-the-rules",
      "name": "Run the rules",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Pando Supabase RPC"
        }
      },
      "notes": "",
      "notesInFlow": false,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "pando-anything-flagged-c0",
              "leftValue": "={{ $json.reason }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        300
      ],
      "id": "pando-anything-flagged",
      "name": "Anything flagged?",
      "notes": "",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "/* The same rule firing every 15 minutes must not produce 96 identical flags. */\nreturn $input.all().map(item => ({ json: { payload: {\n  severity: item.json.severity,\n  reason: item.json.reason,\n  subject_kind: item.json.subject_kind,\n  subject_id: item.json.subject_id,\n  person_id: item.json.person_id,\n  excerpt: item.json.excerpt,\n} } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        300
      ],
      "id": "pando-skip-what-is-already-flagged",
      "name": "Skip what is already flagged",
      "notes": "",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/write_flags_if_new",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Profile",
              "value": "public"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: { flags: $json.flags } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "id": "pando-save-flag-if-new",
      "name": "Save flag if new",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Pando Supabase RPC"
        }
      },
      "notes": "",
      "notesInFlow": false,
      "alwaysOutputData": true
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -220,
        480
      ],
      "id": "pando-nothing-to-flag",
      "name": "Nothing to flag"
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Run the rules",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run the rules": {
      "main": [
        [
          {
            "node": "Anything flagged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything flagged?": {
      "main": [
        [
          {
            "node": "Skip what is already flagged",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing to flag",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip what is already flagged": {
      "main": [
        [
          {
            "node": "Save flag if new",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "pando"
  },
  "tags": [
    {
      "name": "pando"
    }
  ]
}
