{
  "name": "Pando · admin read (HTTP)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "admin-read-http",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -420,
        300
      ],
      "id": "pando-webhook",
      "name": "Webhook",
      "webhookId": "pando-admin-read",
      "notes": "POST from /api/admin/query with { resource, params }.\nThe app already checked the session — n8n never reads a cookie.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/admin_read",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Profile",
              "value": "public"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: $json.body }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        300
      ],
      "id": "pando-read",
      "name": "Read the resource",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Pando Supabase RPC"
        }
      },
      "notes": "One function, one Switch inside it — the eleven projections the\nadmin pages read. Which rows an admin sees is a query; what to do\nabout them is still an IF on this canvas.",
      "notesInFlow": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// The rows come back shaped exactly like web/lib/admin/types.ts, so nothing\n// here reshapes them. `configured: true` is what stops the pages offering\n// sample rows.\nconst first = $input.first()?.json ?? {};\nreturn [{ json: { configured: true, rows: first.rows ?? null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        300
      ],
      "id": "pando-compose-rows",
      "name": "Compose rows"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        300,
        300
      ],
      "id": "pando-respond",
      "name": "Respond"
    }
  ],
