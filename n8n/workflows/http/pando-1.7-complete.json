      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst personId = $('Find person').first().json;\nreturn [{ json: {\n  person_id: personId,\n  allowance: {\n    person_id: personId,\n    monthly_contact_allowance: body.monthly_contact_allowance ?? 3,\n    allowance_mode: body.allowance_mode || 'fixed',\n  },\n  consent: {\n    person_id: personId,\n    scope: 'follow_up',\n    status: body.consent?.status || (body.follow_up_opt_in ? 'opted_in' : 'declined'),\n    source: body.consent?.source || 'seed_completion_screen',\n    text_version: body.consent?.text_version,\n    captured_at: body.consent?.captured_at,\n  },\n} }];"
      },
