      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst d = body.demand;\nlet personId = null;\ntry { personId = $('Find person').first().json ?? null; } catch (e) {}\nreturn [{ json: {\n  sensitivity: d.sensitivity || 'ordinary',\n  payload: {\n    person_id: personId,\n    question_text: d.question_text,\n    category: d.category || null,\n    sensitivity: d.sensitivity || 'ordinary',\n    // Anything not ordinary waits for a person before it can be used.\n    requires_human_review: (d.sensitivity || 'ordinary') !== 'ordinary',\n    is_test: body.is_test === true,\n  },\n} }];"
      },
