{
  "name": "Pando · founding qualification (HTTP)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "founding-check-http",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -420,
        300
      ],
      "id": "pando-webhook",
      "name": "Webhook",
      "webhookId": "pando-webhook",
      "notes": "Called with { person_id } after a contribution is approved.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/founding_checklist_for",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Profile",
              "value": "public"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: { person_id: $json.body.person_id } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
      ],
      "id": "pando-read-the-checklist",
      "name": "Read the checklist",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Pando Supabase RPC"
        }
      },
      "notes": "Every criterion as a column, so the IF below IS the rule.",
      "notesInFlow": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "pando-qualifies-c0",
              "leftValue": "={{ $json.verified }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "pando-qualifies-c1",
              "leftValue": "={{ $json.has_neighborhood }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "pando-qualifies-c2",
              "leftValue": "={{ $json.has_children }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "pando-qualifies-c3",
              "leftValue": "={{ $json.allowance_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "pando-qualifies-c4",
              "leftValue": "={{ $json.qualifying_approved }}",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
        300
      ],
      "id": "pando-qualifies",
      "name": "Qualifies?",
      "notes": "The client's rule: verified phone, a neighborhood, a child, allowance\nat 3 or more, and TWO approved qualifying contributions. Add\ncaregiver_approved >= 1 here for the exceptional-nomination override.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { payload: {\n  person_id: $('Webhook').first().json.body.person_id,\n  status: 'founding',\n  actor: 'workflow',\n} } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        180
      ],
      "id": "pando-build-founding",
      "name": "Build founding",
      "notes": "",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/set_founding",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Profile",
              "value": "public"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: $json.payload }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        180
      ],
      "id": "pando-grant-founding",
      "name": "Grant founding",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Pando Supabase RPC"
        }
      },
      "notes": "Records the outcome. Refuses to downgrade — founding is permanent.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        240,
        420
      ],
      "id": "pando-not-yet",
      "name": "Not yet"
    },
    {
      "parameters": {
        "jsCode": "const c = $('Read the checklist').first().json;\nreturn [{ json: {\n  persisted: true,\n  qualifying_approved: c.qualifying_approved,\n  became_founding: c.qualifying_approved >= 2 && c.verified\n    && c.has_neighborhood && c.has_children && c.allowance_ok,\n  checklist: c,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "id": "pando-compose-response",
      "name": "Compose response",
      "notes": "",
      "notesInFlow": false
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "id": "pando-respond",
      "name": "Respond"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
