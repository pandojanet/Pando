    {
      "parameters": {
        "jsCode": "/* Every judgement about this card is made here, in the open:\n     - firsthand vs a friend's experience (R2) decides the label and whether it\n       can ever count toward Founding;\n     - caveat_answered is true when the step was ANSWERED, including \"nothing\n       comes to mind\" — the client counts that, so an empty string still counts;\n     - the place id comes from whichever branch ran. */\nconst body = $('Webhook').first().json.body;\nconst f = body.fields;\n\nlet placeId;\ntry { placeId = $('Create place').first().json.place_id; } catch (e) { placeId = null; }\nif (!placeId) placeId = $('Find matching place').first().json.id;\n\nreturn [{ json: { payload: {\n  place_id: placeId,\n  person_id: $('Find person').first().json?.person_id ?? null,\n  submission_id: $('Save submission').first().json.submission_id,\n  firsthand: f.firsthand === 'yes',\n  child_age_at_time: f.child_age || [],\n  last_there: f.freshness || null,\n  how_much: f.how_much || null,\n  recommendation: f.recommendation || null,\n  what_makes_it_great: f.what_makes_it_great || null,\n  caveat: f.caveat || null,\n  caveat_answered: Object.prototype.hasOwnProperty.call(f, 'caveat'),\n  who_for: f.who_for || null,\n  who_not_for: f.who_not_for || null,\n  price_band: f.price_band || null,\n  price_unit: f.price_unit || null,\n  worth_it: f.worth_it || null,\n  follow_up_ok: f.follow_up_ok === 'yes',\n  tip_text: f.tip || null,\n  is_test: body.is_test === true,\n} } }];"
      },
