    {
      "parameters": {
        "jsCode": "/* The rule the client asked for, in one readable place.\n   Anything other than a clear \"yes\" to \"would you hire them again\", and any\n   restricted note, keeps the card but holds it for a human — and the parent was\n   already told so on the screen. A hold can be added later; it is never cleared. */\nconst body = $('Webhook').first().json.body;\nconst f = body.fields;\n\nconst hold = [];\nif (f.hire_again && f.hire_again !== 'yes') hold.push('hire_again_' + f.hire_again);\nif (body.private_note)       hold.push('private_note');\nif (body.hesitation_reason)  hold.push('hesitation_reason');\n\nconst notes = [];\nif (body.private_note)      notes.push({ kind: 'private_note', body: body.private_note });\nif (body.hesitation_reason) notes.push({ kind: 'hesitation_reason', body: body.hesitation_reason });\n\nlet caregiverId;\ntry { caregiverId = $('Create caregiver').first().json.caregiver_id; } catch (e) { caregiverId = null; }\nif (!caregiverId) caregiverId = $('Find matching caregiver').first().json.id;\n\nreturn [{ json: {\n  hold,\n  held: hold.length > 0,\n  caregiver_id: caregiverId,\n  payload: {\n    caregiver_id: caregiverId,\n    person_id: $('Find person').first().json?.person_id ?? null,\n    submission_id: $('Save submission').first().json.submission_id,\n    worked_for_family: true,\n    care_type: f.type || null,\n    how_known: f.how_known || null,\n    how_long: f.how_long || null,\n    last_worked: f.last_worked || null,\n    cared_for_ages: f.cared_for_ages || [],\n    strengths: f.strengths || [],\n    in_their_words: f.what_makes_special || null,\n    good_fit_for: f.good_fit_for || [],\n    caveat: f.caveat || null,\n    hire_again: f.hire_again || null,\n    needs_horizon: f.needs_horizon || null,\n    needs_change_type: f.needs_change_type || null,\n    recontact_ok: f.recontact_ok === 'yes',\n    pay_band: f.pay_band || null,\n    pay_benchmark_consent: f.pay_benchmark_ok === 'yes',\n    reference_willing: f.reference_willing || null,\n    invite_sent_by_parent: f.send_invite === 'yes',\n    review_hold: hold.length > 0,\n    hold_reasons: hold,\n    restricted_notes: notes,\n    is_test: body.is_test === true,\n  },\n} }];"
      },
