      "parameters": {
        "jsCode": "// The card exactly as captured. Upsert key is client_id, so a correction\n// (the parent tapping \"Fix\" on a saved card) overwrites instead of duplicating.\nconst body = $('Webhook').first().json.body;\nconst personId = $('Find person').first().json?.person_id ?? null;\nreturn [{ json: { body, person_id: personId, payload: {\n  client_id: body.client_id,\n  person_id: personId,\n  kind: body.kind,\n  fields: body.fields,\n  is_test: body.is_test === true,\n  received_at: body.received_at,\n} } }];"
      },
