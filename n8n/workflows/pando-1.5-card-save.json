      "parameters": {
        "jsCode": "// Its own node, so the admin queue's contents stay traceable to a rule.\nreturn [{ json: { payload: {\n  severity: 'review',\n  reason: 'possible_duplicate_place',\n  subject_kind: 'place',\n  subject_id: $('Create place').first().json.place_id,\n  excerpt: $('Name the place').first().json.name\n    + ' — similar to ' + ($('Build place').first().json.candidate_id ?? 'an existing row'),\n} } }];"
