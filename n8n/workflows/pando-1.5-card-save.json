    {
      "parameters": {
        "jsCode": "/* Creating a place, and noting whether something similar was already there.\n   A near-match is never merged silently — a wrong merge is invisible and\n   permanent, a duplicate is neither — so we create, then flag it for a human. */\nconst body = $('Webhook').first().json.body;\nconst f = body.fields;\nconst candidate = $('Find matching place').first().json;\nconst nearDupe = !candidate.exact_match && (candidate.score ?? 0) > 0.6;\n\nreturn [{ json: { near_dupe: nearDupe, candidate_id: candidate.id ?? null, payload: {\n  market_id: body.market_id || 'pasadena',\n  kind: body.kind,\n  name: f.name || f.topic || 'Untitled',\n  venue: f.venue || null,\n  neighborhoods: f.location || [],\n  age_bands: f.best_for || [],\n  place_type: f.type || null,\n  topic: f.topic || null,\n  is_test: body.is_test === true,\n} } }];"
      },
